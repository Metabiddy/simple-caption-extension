{
  "manifest_version": 3,
  "name": "Caption",
  "version": "1.0.0",
  "description": "Load local SRT subtitles onto web videos with seek, sync, and delay controls.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.bilibili.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Caption"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*/*"
      ],
      "js": [
        "src/shared/messages.js",
        "src/shared/storage.js",
        "src/lib/srt-parser.js",
        "src/lib/subtitle-renderer.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
